{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vscode": "VSCODE_BUILD=1 vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:fuzzy": "node --experimental-strip-types --test scripts/fuzzy-path.test.ts",
    "test:scope": "node --experimental-strip-types --test scripts/scope-rules.test.ts",
    "test:grouping": "node --experimental-strip-types --test scripts/graph-grouping.test.ts",
    "test:ceiling": "node --experimental-strip-types --test scripts/draw-ceiling.test.ts",
    "test:diff": "node --experimental-strip-types --test scripts/diff-rollup.test.ts",
    "test:arrivals": "node --experimental-strip-types --test scripts/arrivals.test.ts",
    "test:empty": "node --experimental-strip-types --test scripts/empty-canvas.test.ts",
    "test:degree": "node --experimental-strip-types --test scripts/degree-size.test.ts",
    "test:search": "node --experimental-strip-types --test scripts/search-results.test.ts",
    "test:keymap": "node --experimental-strip-types --test scripts/keymap.test.ts",
    "test:refpaths": "node --experimental-strip-types --test scripts/ref-paths.test.ts",
    "test:children": "node --experimental-strip-types --test scripts/description-children.test.ts",
    "test:spec-graph": "node --experimental-strip-types --test scripts/spec-graph.test.ts",
    "test:linkgeom": "node --experimental-strip-types --test scripts/link-geometry.test.ts",
    "test:langscope": "node --experimental-strip-types --test scripts/analysis-scope.test.ts",
    "test:quality-population": "node --experimental-strip-types --test scripts/quality-population.test.ts",
    "test:overview": "node --experimental-strip-types --test scripts/overview-frame.test.ts",
    "test:marks": "node --experimental-strip-types --test scripts/mark-set.test.ts",
    "test:saved-views": "node --experimental-strip-types --test scripts/saved-views.test.ts",
    "test": "npm run test:fuzzy && npm run test:scope && npm run test:grouping && npm run test:ceiling && npm run test:diff && npm run test:arrivals && npm run test:empty && npm run test:degree && npm run test:search && npm run test:keymap && npm run test:refpaths && npm run test:children && npm run test:spec-graph && npm run test:linkgeom && npm run test:langscope && npm run test:quality-population && npm run test:overview && npm run test:marks && npm run test:saved-views"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.12.2",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
